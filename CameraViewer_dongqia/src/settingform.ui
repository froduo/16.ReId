<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>SettingForm</class>
 <widget class="QDialog" name="SettingForm">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>580</width>
    <height>560</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>系统配置</string>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <property name="spacing">
    <number>10</number>
   </property>
   <property name="leftMargin"><number>12</number></property>
   <property name="topMargin"><number>12</number></property>
   <property name="rightMargin"><number>12</number></property>
   <property name="bottomMargin"><number>12</number></property>
   <item>
    <widget class="QTabWidget" name="tabWidget">
     <!-- ===== Tab 1: 相机设置 ===== -->
     <widget class="QWidget" name="tabCamera">
      <attribute name="title">
       <string>相机设置</string>
      </attribute>
      <layout class="QFormLayout" name="cameraFormLayout">
       <property name="horizontalSpacing"><number>12</number></property>
       <property name="verticalSpacing"><number>8</number></property>
       <item row="0" column="0">
        <widget class="QLabel" name="label_ip">
         <property name="text"><string>相机 IP:</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <widget class="QLineEdit" name="edit_cameraIP">
         <property name="placeholderText"><string>例: 192.168.99.10</string></property>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_user">
         <property name="text"><string>用户名:</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QLineEdit" name="edit_cameraUser"/>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_pass">
         <property name="text"><string>密码:</string></property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QLineEdit" name="edit_cameraPass">
         <property name="echoMode"><enum>QLineEdit::Password</enum></property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_port">
         <property name="text"><string>RTSP 端口:</string></property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QSpinBox" name="spin_cameraPort">
         <property name="minimum"><number>1</number></property>
         <property name="maximum"><number>65535</number></property>
         <property name="value"><number>554</number></property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="label_rtspUrl">
         <property name="text"><string>RTSP URL:</string></property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QLineEdit" name="edit_rtspUrl">
         <property name="toolTip"><string>完整 RTSP 地址。修改 IP/用户名/密码/端口后点击右侧按钮自动生成</string></property>
        </widget>
       </item>
       <item row="5" column="1">
        <widget class="QPushButton" name="btn_rebuildUrl">
         <property name="text"><string>⟳ 根据上方参数生成 RTSP URL</string></property>
         <property name="toolTip"><string>用 IP、用户名、密码、端口拼接生成 RTSP URL</string></property>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- ===== Tab 2: 推理设置 ===== -->
     <widget class="QWidget" name="tabInference">
      <attribute name="title">
       <string>推理设置</string>
      </attribute>
      <layout class="QVBoxLayout" name="inferMainLayout">
       <property name="spacing"><number>10</number></property>
       <!-- 模型 GroupBox -->
       <item>
        <widget class="QGroupBox" name="groupBox_model">
         <property name="title"><string>模型配置</string></property>
         <layout class="QFormLayout" name="modelFormLayout">
          <property name="verticalSpacing"><number>8</number></property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_enableInfer">
            <property name="text"><string>启用推理:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QCheckBox" name="check_enableInference">
            <property name="checked"><bool>true</bool></property>
            <property name="text"><string>勾选后启动采集时自动加载模型</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_modelPath">
            <property name="text"><string>模型路径:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <layout class="QHBoxLayout" name="modelPathLayout">
            <item>
             <widget class="QLineEdit" name="edit_modelPath">
              <property name="placeholderText"><string>支持 .engine (TensorRT) 和 .onnx (OpenCV DNN)</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="btn_browseModel">
              <property name="text"><string>...</string></property>
              <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
              <property name="toolTip"><string>浏览选择模型文件</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
       <!-- 检测参数 GroupBox -->
       <item>
        <widget class="QGroupBox" name="groupBox_detParams">
         <property name="title"><string>检测参数</string></property>
         <layout class="QFormLayout" name="detParamsLayout">
          <property name="verticalSpacing"><number>8</number></property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_confThreshold">
            <property name="text"><string>置信度阈值:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="spin_confThreshold">
            <property name="minimum"><double>0.01</double></property>
            <property name="maximum"><double>1.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>0.45</double></property>
            <property name="decimals"><number>2</number></property>
            <property name="toolTip"><string>检测置信度阈值，低于此值的检测结果将被忽略</string></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_nmsThreshold">
            <property name="text"><string>NMS 阈值:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spin_nmsThreshold">
            <property name="minimum"><double>0.01</double></property>
            <property name="maximum"><double>1.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>0.50</double></property>
            <property name="decimals"><number>2</number></property>
            <property name="toolTip"><string>非极大值抑制阈值，值越小去重越严格</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <!-- 跟踪参数 GroupBox -->
       <item>
        <widget class="QGroupBox" name="groupBox_trackerParams">
         <property name="title"><string>跟踪 and ReID 参数</string></property>
         <layout class="QFormLayout" name="trackerParamsLayout">
          <property name="verticalSpacing"><number>8</number></property>
          <item row="0" column="0">
           <widget class="QLabel" name="label_iouThreshold">
            <property name="text"><string>IoU 匹配阈值:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QDoubleSpinBox" name="spin_iouThreshold">
            <property name="minimum"><double>0.01</double></property>
            <property name="maximum"><double>1.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>0.30</double></property>
            <property name="decimals"><number>2</number></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="label_maxMissed">
            <property name="text"><string>最大丢失帧数:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QSpinBox" name="spin_maxMissed">
            <property name="minimum"><number>1</number></property>
            <property name="maximum"><number>300</number></property>
            <property name="value"><number>30</number></property>
            <property name="toolTip"><string>跟踪目标连续丢失多少帧后丢弃</string></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="label_reidThreshold">
            <property name="text"><string>ReID 匹配阈值:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="spin_reidThreshold">
            <property name="minimum"><double>0.10</double></property>
            <property name="maximum"><double>1.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>0.70</double></property>
            <property name="decimals"><number>2</number></property>
            <property name="toolTip"><string>ReID 特征匹配相似度阈值，值越大要求越严格</string></property>
           </widget>
          </item>
          <item row="3" column="0">
           <widget class="QLabel" name="label_kalmanEnabled">
            <property name="text"><string>卡尔曼预测:</string></property>
           </widget>
          </item>
          <item row="3" column="1">
           <widget class="QCheckBox" name="check_kalmanEnabled">
            <property name="checked"><bool>true</bool></property>
            <property name="text"><string>启用运动预测匹配（遮挡期间保持轨迹）</string></property>
            <property name="toolTip"><string>使用卡尔曼滤波器预测目标位置，在检测丢失时仍能维持轨迹连续性</string></property>
           </widget>
          </item>
          <item row="4" column="0">
           <widget class="QLabel" name="label_trackerReidEnabled">
            <property name="text"><string>ReID辅助跟踪:</string></property>
           </widget>
          </item>
          <item row="4" column="1">
           <widget class="QCheckBox" name="check_trackerReidEnabled">
            <property name="checked"><bool>true</bool></property>
            <property name="text"><string>启用ReID外观特征辅助匹配（防止ID切换）</string></property>
            <property name="toolTip"><string>当IoU匹配失败时，使用ReID外观特征进行二次匹配，大幅减少同一人的ID切换</string></property>
           </widget>
          </item>
          <item row="5" column="0">
           <widget class="QLabel" name="label_trackerReidThreshold">
            <property name="text"><string>跟踪ReID阈值:</string></property>
           </widget>
          </item>
          <item row="5" column="1">
           <widget class="QDoubleSpinBox" name="spin_trackerReidThreshold">
            <property name="minimum"><double>0.10</double></property>
            <property name="maximum"><double>1.00</double></property>
            <property name="singleStep"><double>0.05</double></property>
            <property name="value"><double>0.65</double></property>
            <property name="decimals"><number>2</number></property>
            <property name="toolTip"><string>跟踪器内部ReID匹配阈值（比访客匹配阈值略低，因为是短时间内的匹配）</string></property>
           </widget>
          </item>
          <item row="6" column="0">
           <widget class="QLabel" name="label_galleryMaxAge">
            <property name="text"><string>画廊保留时间(ms):</string></property>
           </widget>
          </item>
          <item row="6" column="1">
           <widget class="QSpinBox" name="spin_galleryMaxAge">
            <property name="minimum"><number>1000</number></property>
            <property name="maximum"><number>60000</number></property>
            <property name="singleStep"><number>1000</number></property>
            <property name="value"><number>10000</number></property>
            <property name="toolTip"><string>丢失轨迹在画廊中的最大保留时间，超时后彻底移除。值越大越能处理长时间遮挡</string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
     <!-- ===== Tab 3: 保存设置 ===== -->
     <widget class="QWidget" name="tabSave">
      <attribute name="title">
       <string>保存设置</string>
      </attribute>
      <layout class="QFormLayout" name="saveFormLayout">
       <property name="horizontalSpacing"><number>12</number></property>
       <property name="verticalSpacing"><number>8</number></property>
       <item row="0" column="0">
        <widget class="QLabel" name="label_savePath">
         <property name="text"><string>图像保存路径:</string></property>
        </widget>
       </item>
       <item row="0" column="1">
        <layout class="QHBoxLayout" name="savePathLayout">
         <item>
          <widget class="QLineEdit" name="edit_savePath"/>
         </item>
         <item>
          <widget class="QPushButton" name="btn_browseSavePath">
           <property name="text"><string>...</string></property>
           <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="label_saveFormat">
         <property name="text"><string>保存格式:</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QComboBox" name="combo_saveFormat">
         <item><property name="text"><string>jpg</string></property></item>
         <item><property name="text"><string>png</string></property></item>
         <item><property name="text"><string>bmp</string></property></item>
         <item><property name="text"><string>tif</string></property></item>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="label_jpegQuality">
         <property name="text"><string>JPEG 质量:</string></property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QSpinBox" name="spin_jpegQuality">
         <property name="minimum"><number>1</number></property>
         <property name="maximum"><number>100</number></property>
         <property name="value"><number>95</number></property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="label_reidSavePath">
         <property name="text"><string>ReID 图像路径:</string></property>
        </widget>
       </item>
       <item row="3" column="1">
        <layout class="QHBoxLayout" name="reidSavePathLayout">
         <item>
          <widget class="QLineEdit" name="edit_reidSavePath"/>
         </item>
         <item>
          <widget class="QPushButton" name="btn_browseReidSavePath">
           <property name="text"><string>...</string></property>
           <property name="maximumSize"><size><width>32</width><height>16777215</height></size></property>
          </widget>
         </item>
        </layout>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="label_regionSavePath">
         <property name="text"><string>区域配置路径:</string></property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QLineEdit" name="edit_regionSavePath">
         <property name="toolTip"><string>检测区域配置的 JSON 保存路径</string></property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
   <item>
    <widget class="QDialogButtonBox" name="buttonBox">
     <property name="orientation"><enum>Qt::Horizontal</enum></property>
     <property name="standardButtons">
      <set>QDialogButtonBox::Cancel|QDialogButtonBox::Ok</set>
     </property>
    </widget>
   </item>
  </layout>
 </widget>
 <resources/>
 <connections>
  <connection>
   <sender>buttonBox</sender>
   <signal>accepted()</signal>
   <receiver>SettingForm</receiver>
   <slot>accept()</slot>
  </connection>
  <connection>
   <sender>buttonBox</sender>
   <signal>rejected()</signal>
   <receiver>SettingForm</receiver>
   <slot>reject()</slot>
  </connection>
 </connections>
</ui>
